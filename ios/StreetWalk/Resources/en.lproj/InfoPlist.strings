"CFBundleDisplayName" = "Kaifong Walk";

"NSLocationWhenInUseUsageDescription" = "Uses the streets and blocks near you to build a small 3D map of your estate. On walks, location draws the path you took. Your routes stay on this phone and are never uploaded. Others only see landmarks.";

"NSLocationAlwaysAndWhenInUseUsageDescription" = "Choose \"Always Allow\" so your walks are recorded even when the phone is locked, and your neighbours can know you are out. Where you live stays on this phone. Others only see landmarks.";

"NSMicrophoneUsageDescription" = "Listens when you speak, for example \"Walk with Mrs Chan tomorrow\".";

"NSMotionUsageDescription" = "Notices when you are walking and records your walk without any buttons. Walks taken while the phone was locked are added when you open the app.";

"NSSpeechRecognitionUsageDescription" = "Turns what you say into text so the app understands what you want.";

"NSLocalNetworkUsageDescription" = "Finds the other phone next to you when you tap phones to add a neighbour. Also connects to the voice service on the same Wi-Fi for a more natural voice.";

"NSNearbyInteractionUsageDescription" = "Measures how close two phones are when you tap phones. When finding a neighbour, shows which way they are when you are close.";

"NSCameraUsageDescription" = "If your phone can't tap phones, scan a neighbour's QR code with the camera to add them. When finding a neighbour up close, the camera helps show which way they are.";
