<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merge with the generated Info.plist. Include keys not expressible through INFOPLIST_KEY_* (arrays and background modes), plus required permission descriptions.
     Keep outside StreetWalk/: synchronized folders would copy an internal plist as a resource, conflicting with the generated Info.plist.
     Keep permission descriptions aligned with any localized InfoPlist.strings under the Mandarin and Cantonese resource directories. -->
<plist version="1.0">
<dict>
	<!-- F1 automatic recording and departure detection: request background wakeups on departure and location updates during walks. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>hk.hack4sdg.streetwalk.refresh</string>
	</array>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>揀「始終允許」，你出門散步時就算手機鎖咗都會自動記錄，亦可以話俾你嘅街坊知你出咗門。你屋企喺邊只會留喺呢部手機，對外只講地標。</string>
	<!-- F5 pairing: discover the other phone through the local network, then measure proximity with UWB.
	     _jiefongvoice._tcp discovers the Mac voice server on the same Wi-Fi network (tools/voice_server.sh). -->
	<key>NSBonjourServices</key>
	<array>
		<string>_jiefong._tcp</string>
		<string>_jiefongvoice._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>碰一碰加街坊時，用嚟搵到身邊另一部手機；亦用嚟連接同一個 Wi-Fi 入面嘅語音服務，令讀出嚟嘅聲更自然。</string>
	<!-- The Mac voice server uses LAN HTTP (http://192.168.x.x:8765); allow local networking through NSAllowsLocalNetworking.
	     Public connections still require HTTPS, including the tunnel option's trycloudflare URL. See server/README.md. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSNearbyInteractionUsageDescription</key>
	<string>碰一碰時量度兩部手機有幾近；搵街坊時喺附近指出佢喺邊個方向。</string>
	<key>NSCameraUsageDescription</key>
	<string>手機唔支援碰一碰時，用鏡頭掃街坊嘅二維碼加街坊；搵街坊時喺好近嘅距離，用鏡頭幫手指出佢喺邊個方向。</string>
	<!-- Dynamic Island / Lock Screen Live Activity for walking, finding, and upcoming meetups; StreetWalkWidgets renders locally supplied updates. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
</dict>
</plist>
