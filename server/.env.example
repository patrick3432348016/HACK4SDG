# Copy to .env for Docker Compose. Never commit real secrets.
ASSISTANT_MODE=demo
ASSISTANT_DATABASE=/app/data/assistant.sqlite3
DEMO_TOKEN=local-demo-only
AZURE_SPEECH_KEY=
# Full speech URLs copied from the Azure resource's documentation.
AZURE_STT_URL=
AZURE_TTS_URL=
QWEN_API_KEY=
# Compatible-mode base URL, without /chat/completions. Use the key's own region.
QWEN_BASE_URL=
QWEN_MODEL=
# A's HTTPS backend base URL. Required only for production.
BUSINESS_BASE_URL=
# ── 成员 A 加（街坊行）：tools/voice_server.sh 会自动设定以下几项 ──
# ASSISTANT_MODE=supabase                      # 用户 token 交 Supabase 核实，约人写入 meetups
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_…           # publishable key（本来就喺 App 入面）
# TTS_PROVIDER=sovits                          # auto | sovits | azure | none
# SOVITS_ROOT=~/Desktop/HACK/voice-runtime/gptsovits
# SOVITS_REF_WAV=…/ref/cv_yue_f2.wav
# SOVITS_REF_TEXT=…/ref/cv_yue_f2.txt
# SPEECH_CACHE_DIR=…/data/tts-cache
# SPEECH_LAN_OPEN=true                         # 局域网直接连入嘅播报请求唔使登录（经隧道 / 代理一定要）
# NLTK_DATA=…/nltk_data
