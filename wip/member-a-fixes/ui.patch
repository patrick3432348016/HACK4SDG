+        var dh = 0.0
+        if C1p * C2p != 0 { dh = abs(h2p - h1p) <= 180 ? h2p - h1p : (h2p > h1p ? h2p - h1p - 360 : h2p - h1p + 360) }
+        let dH = 2 * sqrt(C1p * C2p) * sin(dh / 2 * rad)
