+/// 色弱模拟（Machado 2009，严重度 1.0）+ CIEDE2000，同 ios/tools/cvd_check.py 一致。
+enum CVD {
+    static let matrices: [String: [[Double]]] = [
+        "红色盲": [[0.152286, 1.052583, -0.204868], [0.114503, 0.786281, 0.099216], [-0.003882, -0.048116, 1.051998]],
