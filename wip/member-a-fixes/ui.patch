+        let a1p = (1 + G) * a1, a2p = (1 + G) * a2
+        let C1p = hypot(a1p, b1), C2p = hypot(a2p, b2)
+        func hue(_ b: Double, _ a: Double) -> Double { let h = atan2(b, a) / rad; return h < 0 ? h + 360 : h }
+        let h1p = hue(b1, a1p), h2p = hue(b2, a2p)
